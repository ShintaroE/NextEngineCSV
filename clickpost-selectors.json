{
  "description": "クリックポストサイトのセレクター設定ファイル",
  "lastUpdated": "2026-03-09",
  "note": "実際のサイト構造に合わせて調整してください。開発者ツール(F12)でセレクターを確認できます。",

  "urls": {
    "top": "https://clickpost.jp/",
    "login": "https://login.yahoo.co.jp/config/login",
    "mypage": "https://clickpost.jp/mypage",
    "newLabel": "https://clickpost.jp/mypage/new",
    "bulkUpload": "https://clickpost.jp/mypage/import",
    "multiplePayment": "https://clickpost.jp/labels/multiple_payment"
  },

  "login": {
    "username": "#username",
    "password": "#passwd",
    "nextButton": "#btnNext",
    "submitButton": "#btnSubmit"
  },

  "labelForm": {
    "note": "新規ラベル作成フォームのセレクター（要調整）",
    "postalCode": "input[name='postal_code'], input[id*='postal'], input[name*='postal']",
    "recipientName": "input[name='recipient_name'], input[id*='name'], input[name*='name']",
    "address1": "input[name='address1'], textarea[name='address1']",
    "address2": "input[name='address2'], textarea[name='address2']",
    "address3": "input[name='address3'], textarea[name='address3']",
    "content": "input[name='content'], textarea[name='content']",
    "submitButton": "button[type='submit'], input[type='submit'], button.btn-primary"
  },

  "payment": {
    "cvv": "#cvv",
    "consentCheckbox": "#consent-matters-agree",
    "confirmButton": "#payment_complete_message > input, button[type='submit']"
  },

  "navigation": {
    "newLabelButton": "a[href*='new'], a[href*='regist'], .btn-new-label",
    "bulkUploadButton": "input[value='まとめ申込'], input.navi_button[value='まとめ申込']",
    "myPageIndicator": "#mypage, .mypage-container, [class*='mypage']"
  },

  "errors": {
    "errorMessage": ".error-message, .alert-danger, [class*='error'], .alert-error",
    "validationError": ".field_with_errors, .has-error, [class*='invalid']"
  },

  "bulkUpload": {
    "note": "まとめ申込（CSVアップロード）ページのセレクター",
    "fileInput": "input#file-upload-button, input[type='file']",
    "nextButton": "input[value='次へ'], button:has-text('次へ')",
    "confirmImportButton": "button[type='submit'], input[type='submit'], .btn-confirm, .btn-primary",
    "successMessage": ".alert-success, .success-message, [class*='success']",
    "importResultTable": "table, .import-result, .result-table"
  },

  "paymentList": {
    "note": "まとめ申込 支払手続き画面のセレクター",
    "listTable": "table, .label-list, .payment-list",
    "dataRows": "tbody tr, .data-row",
    "yahooWalletButton": "input.ywallet_button, input[name^='wallet_button']",
    "paymentConfirmButton": "button[type='submit'], input[type='submit'], #payment_complete, .btn-confirm"
  }
}
